PORT=3000

# Credenciais de acesso ao Painel (Login)
ADMIN_USER="elly"
ADMIN_PASS="elly123"

# Contacto WhatsApp do Fotógrafo
WHATSAPP_NUMERO="244923000000"
WHATSAPP_FOTOGRAFO="244923000000"

# Armazenamento Cloudflare R2 (opcional)
CLOUDFLARE_R2_ACCOUNT_ID="seu_account_id_cloudflare"
CLOUDFLARE_R2_ACCESS_KEY_ID="sua_access_key_id"
CLOUDFLARE_R2_SECRET_ACCESS_KEY="sua_secret_access_key"
CLOUDFLARE_R2_BUCKET_NAME="elly-galerias"
CLOUDFLARE_PUBLIC_URL="https://galeria.ellyfotografo.com"

# Base de Dados MySQL (opcional - fallback para ficheiros se não definido)
# Se o MySQL corre noutro container Docker, MYSQL_HOST tem de ser o nome do
# serviço/container que resolva DENTRO da rede desse container (ex.: "mysql").
# Um "getaddrinfo ENOTFOUND <nome>" significa que esse nome não existe na
# rede: corrija o host ou a network no docker-compose. O servidor reconecta
# sozinho quando a ligação cai, sem ser preciso reiniciar.
MYSQL_HOST="localhost"
MYSQL_USER="root"
MYSQL_PASSWORD=""
MYSQL_DATABASE="elly_fotografo"
MYSQL_PORT=3306

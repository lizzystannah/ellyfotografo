# ====================================================================
# Configuração Nginx para VPS (Produção)
# ====================================================================

# --------------------------------------------------------------------
# Cenário 1: Domínio dedicado ou subdomínio (RECOMENDADO)
# Exemplos: elifotografo.com  OU  galeria.seudominio.com
# --------------------------------------------------------------------
server {
    listen 80;
    server_name elifotografo.com galeria.seudominio.com;

    # Limite de upload de 500MB (essencial para envio de lotes de fotografias)
    client_max_body_size 500M;

    # Redirecionamento automático HTTP -> HTTPS (gerado pelo Certbot)
    # return 301 https://$host$request_uri;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        proxy_read_timeout 300s;
        proxy_connect_timeout 300s;
        proxy_send_timeout 300s;
    }
}

